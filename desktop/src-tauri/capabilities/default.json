{
  "$schema": "https://schema.tauri.app/schema/2/capability.json",
  "identifier": "default",
  "description": "Default capability for teshi-desktop",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "dialog:default",
    "window-state:default"
  ]
}
