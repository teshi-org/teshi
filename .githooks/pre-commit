#!/bin/bash
set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[0;33m'
GREEN='\033[0;32m'
NC='\033[0m'
PASS=true

# ---- 0. Toolchain alignment check -----------------------------------------
echo ":: Toolchain check ..."
RUSTUP_CHECK=$(rustup check 2>/dev/null || true)
if echo "$RUSTUP_CHECK" | grep -q "Update available"; then
    echo -e "${YELLOW}   !  Stable toolchain update available. Run 'rustup update stable' to match CI.${NC}"
    echo -e "${YELLOW}      (Not a hard failure)${NC}"
fi
echo -e "${GREEN}   - OK${NC}"

# ---- 1. cargo fmt ----------------------------------------------------------
echo ":: Formatting check (cargo fmt --all --check) ..."
if ! cargo fmt --all --check 2>/dev/null; then
    echo -e "${RED}   x  Unformatted code. Run 'cargo fmt --all' to fix.${NC}"
    PASS=false
else
    echo -e "${GREEN}   - OK${NC}"
fi

# ---- 2. cargo check --------------------------------------------------------
echo ":: Compilation check (cargo check) ..."
if ! cargo check 2>/dev/null; then
    echo -e "${RED}   x  Compilation errors.${NC}"
    PASS=false
else
    echo -e "${GREEN}   - OK${NC}"
fi

# ---- 2b. cargo check --locked ---------------------------------------------
echo ":: Lock file check (cargo check --locked) ..."
if ! cargo check --locked 2>/dev/null; then
    echo -e "${RED}   x  Cargo.lock is out of sync. Run 'cargo check' and stage Cargo.lock too.${NC}"
    PASS=false
else
    echo -e "${GREEN}   - OK${NC}"
fi

# ---- 2c. Root package version sync ------------------------------------------
echo ":: Root version check (Cargo.toml vs Cargo.lock) ..."
CARGO_VERSION=$(grep -m1 '^version = ' Cargo.toml | tr -d '\r' | sed 's/version = "\(.*\)"/\1/')
LOCK_VERSION=$(grep -A2 '^name = "teshi"' Cargo.lock | grep '^version = ' | tr -d '\r' | sed 's/version = "\(.*\)"/\1/')
if [ -z "$CARGO_VERSION" ] || [ -z "$LOCK_VERSION" ]; then
    echo -e "${YELLOW}   !  Could not extract version from Cargo.toml or Cargo.lock.${NC}"
elif [ "$CARGO_VERSION" != "$LOCK_VERSION" ]; then
    echo -e "${RED}   x  Cargo.lock root package version ($LOCK_VERSION) does not match Cargo.toml ($CARGO_VERSION). Run 'cargo generate-lockfile' and stage Cargo.lock.${NC}"
    PASS=false
else
    echo -e "${GREEN}   - OK ($CARGO_VERSION)${NC}"
fi

# ---- 2d. Version sync across all component files ----------------------------
echo ":: Component version sync check ..."
MISMATCH=false
VERSION_FILES=(
  "apps/teshi-cli/Cargo.toml:^version = "
  "extension/teshi-bridge/manifest.json:\"version\": "
)
for entry in "${VERSION_FILES[@]}"; do
    FILE="${entry%%:*}"
    PATTERN="${entry#*:}"
    FOUND=$(grep -m1 "$PATTERN" "$FILE" 2>/dev/null | tr -d '\r' | sed 's/.*"\([0-9]*\.[0-9]*\.[0-9]*\)".*/\1/' | sed 's/.*= "\([0-9]*\.[0-9]*\.[0-9]*\)".*/\1/')
    if [ -n "$FOUND" ]; then
        echo "   $FILE  →  $FOUND"
    fi
done
# Compare all extracted versions
VALS=()
for entry in "${VERSION_FILES[@]}"; do
    FILE="${entry%%:*}"
    PATTERN="${entry#*:}"
    FOUND=$(grep -m1 "$PATTERN" "$FILE" 2>/dev/null | tr -d '\r' | sed 's/.*"\([0-9]*\.[0-9]*\.[0-9]*\)".*/\1/' | sed 's/.*= "\([0-9]*\.[0-9]*\.[0-9]*\)".*/\1/')
    VALS+=("$FOUND")
done
REF="${VALS[0]}"
for i in "${!VALS[@]}"; do
    if [ "${VALS[$i]}" != "$REF" ]; then
        FILE="${VERSION_FILES[$i]%%:*}"
        echo -e "${RED}   x  $FILE version (${VALS[$i]}) does not match reference ($REF).${NC}"
        MISMATCH=true
    fi
done
if [ "$MISMATCH" = true ]; then
    echo -e "${RED}   x  Version mismatch detected. Run 'python scripts/release.py --apply' to sync.${NC}"
    PASS=false
else
    echo -e "${GREEN}   - All components at $REF${NC}"
fi

# ---- 2e. 0.7.x version lock ------------------------------------------------
echo ":: 0.7.x version lock check ..."
LOCK_FAIL=0
for entry in "${VERSION_FILES[@]}"; do
    FILE="${entry%%:*}"
    PATTERN="${entry#*:}"
    FOUND=$(grep -m1 "$PATTERN" "$FILE" 2>/dev/null | tr -d '\r' | sed 's/.*"\([0-9]*\.[0-9]*\.[0-9]*\)".*/\1/' | sed 's/.*= "\([0-9]*\.[0-9]*\.[0-9]*\)".*/\1/')
    if [ -n "$FOUND" ]; then
        MAJOR=$(echo "$FOUND" | cut -d. -f1)
        MINOR=$(echo "$FOUND" | cut -d. -f2)
        if [ "$MAJOR" != "0" ] || [ "$MINOR" != "7" ]; then
            echo -e "${RED}   x  $FILE version $FOUND violates 0.7.x lock!${NC}"
            LOCK_FAIL=1
        fi
    fi
done
if [ "$LOCK_FAIL" -eq 1 ]; then
    echo -e "${RED}   x  0.7.x lock violated. Version bumps beyond patch are blocked.${NC}"
    PASS=false
else
    echo -e "${GREEN}   - All versions within 0.7.x${NC}"
fi

# ---- 3. dbg!() in staged .rs files -----------------------------------------
STAGED_DBG=$(git diff --cached -G'dbg!' -- '*.rs' || true)
if [ -n "$STAGED_DBG" ]; then
    echo -e "${RED}   x  dbg!() found in staged files:${NC}"
    echo "$STAGED_DBG" | grep '^+++' | sed 's/^+++ //'
    PASS=false
else
    echo -e "${GREEN}   - No dbg!() in staged files${NC}"
fi

# ---- Result ----------------------------------------------------------------
if [ "$PASS" = false ]; then
    echo -e "${RED}-- pre-commit checks failed -----------------------------------${NC}"
    exit 1
fi
echo -e "${GREEN}-- all pre-commit checks passed -------------------------------${NC}"
