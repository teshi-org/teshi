{
  "method": "POST",
  "url": "{{ base_url }}/users",
  "headers": {% include "_headers.json.j2" %},
  "body": {
    "name": "{{ name }}",
    "role": "{{ role | default('member') }}"
  },
  "extract": {
    "user_id": "{{ response.json.id }}"
  },
  "assert": {
    "status_ok": "{{ response.status == 201 }}"
  }
}
