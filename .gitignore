# Rust build artifacts
target/

# Local Cargo cache (e.g. sandboxed CARGO_HOME under the repo)
.cargo-local/

# Generated by Cargo when using local overrides
**/*.rs.bk

# OS/editor temporary files
.DS_Store
Thumbs.db
*.swp
*.swo

# WSL Claude Agent ACP wrapper (local WSL-specific config)
.claude-agent-acp.sh

# Cursor: ignore local workspace state, keep shared rules
.cursor/*

# OpenSpec change tracking (separate BDD project artifacts)
.agents/

# Miscellaneous working-tree artifacts
tmp/
arch-vision.html
tests/feature/example.feature
!.cursor/rules/
!.cursor/rules/*.mdc

# Codex: local rule copies (canonical copy is under .cursor/rules/)
.codex/

# Local runner config (machine-specific paths); see teshi.toml.example
teshi.toml

# Keep Cargo.lock tracked by default.
# If this repository is a library and you explicitly want to ignore it, uncomment:
# Cargo.lock

# Local Teshi runtime state (traces, daemon, agent context); any nesting
.teshi/
!.teshi/step-bindings/
!.teshi/step-bindings/**

# Local release packaging output (binaries, archives, checksums)
release-pack/
dist/

# Local MSI staging tree (heat/cargo-wix; CI regenerates wix/*.wxs from this)
staging/

# --- Python virtual environments (project under test / local dev) ---
.venv/
venv/
__pycache__/
*.py[cod]

# --- Node / frontend tooling (repo-wide) ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Environment files ---
.env
.env.*

# Auto-generated by cargo wix (heat.exe) from staging; keep main.wxs/License.rtf/Product.ico tracked
wix/bridge-files.wxs
wix/web-files.wxs

teshi-bridge.zip
crates/teshi-tui/testpoints/
