# Rust build artifacts
target/

# Local Cargo cache (e.g. sandboxed CARGO_HOME under the repo)
.cargo-local/

# Generated by Cargo when using local overrides
**/*.rs.bk

# OS/editor temporary files
.DS_Store
Thumbs.db
*.swp
*.swo

# WSL Claude Agent ACP wrapper (local WSL-specific config)
.claude-agent-acp.sh

# Cursor: ignore local workspace state, keep shared rules
.cursor/*
!.cursor/rules/
!.cursor/rules/*.mdc

# Codex: local rule copies (canonical copy is under .cursor/rules/)
.codex/

# Local runner config (machine-specific paths); see teshi.toml.example
teshi.toml

# Keep Cargo.lock tracked by default.
# If this repository is a library and you explicitly want to ignore it, uncomment:
# Cargo.lock

# --- teshi desktop agent context (local runtime state) ---
.teshi/active-step.json
.teshi/pending-locator.json
.teshi/cdp-endpoint.json

# --- teshi-desktop (Tauri + Vite) ---
desktop/node_modules/
desktop/dist/

# --- Python virtual environments (project under test / local dev) ---
.venv/
venv/
__pycache__/
*.py[cod]

# --- Node / frontend tooling (repo-wide) ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Environment files ---
.env
.env.*

# Keep wix/ tracked so MSI customization is reproducible in CI
# wix/
