{
  "manifest_version": 3,
  "name": "teshi-bridge",
  "version": "0.7.0",
  "description": "Connects your Chrome active tab to teshi-desktop for BDD locator recording.",
  "permissions": ["debugger", "activeTab", "alarms", "tabs"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://127.0.0.1:17373/*",
    "http://localhost:17373/*",
    "ws://127.0.0.1/*",
    "ws://localhost/*",
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "teshi-bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
