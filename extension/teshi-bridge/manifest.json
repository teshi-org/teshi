{
  "manifest_version": 3,
  "name": "teshi-bridge",
  "version": "0.1.0",
  "description": "Connects your Chrome active tab to teshi-desktop for BDD locator recording.",
  "permissions": ["debugger", "activeTab", "alarms"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://127.0.0.1:17373/*",
    "http://127.0.0.1:17373/*"
  ],
  "action": {
    "default_title": "teshi-bridge",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
